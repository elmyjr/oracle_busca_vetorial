# Senhas do ambiente de demonstração (só locais, sem dados reais).
# Copie este arquivo para .env antes de subir o compose.
# Use só letras e números, começando por letra.
ORACLE_PASSWORD=Pucminas
APP_USER_PASSWORD=Pucminas

# Portas no computador. Sem estas linhas, o compose já usa 1522 e 8001.
# Mude só se outra aplicação estiver usando a mesma porta.
ORACLE_PORT=1522
APP_PORT=8001

